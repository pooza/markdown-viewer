{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "extends": ["gobou/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["!vendor"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noRedundantUseStrict": "off"
      }
    }
  },
  "javascript": {
    "globals": ["JSZip", "marked", "DOMPurify", "mermaid", "MdvCore"]
  }
}
