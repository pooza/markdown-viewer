{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "extends": ["gobou/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!vendor",
      "!src/viewer.html",
      "!*.md",
      "!.github",
      "src/**/*.js",
      "scripts/**/*.mjs",
      "test/**/*.mjs",
      "test/**/*.cjs",
      "*.json"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noRedundantUseStrict": "off"
      }
    }
  },
  "javascript": {
    "globals": ["JSZip", "marked", "DOMPurify", "mermaid", "MdvCore"]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
